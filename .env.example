# Optional overrides for `docker compose up`. Copy to .env; every value has a working default.

# Signs access tokens. Required for anything beyond local use: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Public URLs (change if you serve DevTrack on another host or port)
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Seed demo data on first start (only when the database is empty)
SEED_DEMO_DATA=true

# Host ports for Postgres/Redis, if 5432/6379 are already taken on your machine
POSTGRES_PORT=5432
REDIS_PORT=6379

# Set to true when serving over HTTPS
COOKIE_SECURE=false
