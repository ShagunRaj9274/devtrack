# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API and open WebSockets (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://devtrack:devtrack@localhost:5432/devtrack?schema=public

# ---- Redis (Socket.IO adapter, BullMQ jobs, analytics cache) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Signs access tokens. At least 32 characters. Generate one with: openssl rand -base64 48
# (The API refuses to start in production with this placeholder.)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
# Refresh tokens are random values stored hashed in the database (no secret needed).
REFRESH_TOKEN_TTL_DAYS=7
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# ---- Rate limiting (requests per minute per client) ----
RATE_LIMIT_PER_MINUTE=300
# Login, register and change-password only
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- Behind a load balancer / proxy ----
# Number of proxy hops whose X-Forwarded-For entries to trust, so rate limits apply per
# visitor instead of per proxy. 0 locally; e.g. 2 for Vercel proxy -> Render -> API.
TRUST_PROXY=0
