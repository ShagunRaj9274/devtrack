# Public URL of the NestJS API as seen from the browser (REST + WebSocket).
# Baked in at build time by Next.js.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Deploying the web app and API on different sites (e.g. Vercel + Render) ----
# Set this instead: the app then proxies /api/* to the API (keeps the login cookie
# first-party) and connects WebSockets straight to it. NEXT_PUBLIC_API_URL is ignored.
# API_PROXY_TARGET=https://your-api.onrender.com
# Optional, only if WebSockets must use a different URL than API_PROXY_TARGET:
# NEXT_PUBLIC_SOCKET_URL=https://your-api.onrender.com
